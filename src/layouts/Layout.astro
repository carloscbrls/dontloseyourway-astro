---
import CrisisBlock from '../components/CrisisBlock.astro';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A quiet space for reflection. Not therapy. Not a fix. Just proof that others have stood where you stand.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, 'https://dontloseyourway.cc3po.com').href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Don't Lose Your Way" />
  <meta property="og:image" content="https://dontloseyourway.cc3po.com/media/hero.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://dontloseyourway.cc3po.com/media/hero.png" />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0a0a12" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand">Don't Lose Your Way</a>
      <nav aria-label="Main navigation">
        <ul class="nav-list">
          <li><a href="/start-here">Start Here</a></li>
          <li><a href="/journal">Journal</a></li>
          <li><a href="/chapel">Chapel</a></li>
          <li><a href="/podcast">Podcast</a></li>
          <li><a href="/resources">Resources</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/partners">Partners</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <div class="crisis-strip" role="region" aria-label="Crisis help">
    <p>
      In crisis? <a href="tel:988">Call or text 988</a> — free, 24/7. Or <a href="sms:741741">text TALK to 741741</a>.
    </p>
  </div>

  <main id="main-content">
    <slot />
    <div class="container">
      <CrisisBlock />
    </div>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p class="footer-mission">This space exists for people who almost gave up — and stayed.</p>
      <nav aria-label="Footer">
        <ul class="footer-links">
          <li><a href="/about">About</a></li>
          <li><a href="/disclaimer">Disclaimer</a></li>
          <li><a href="/legal/terms">Terms</a></li>
          <li><a href="/legal/privacy">Privacy Policy</a></li>
          <li><a href="/legal/ai-disclosure">AI Disclosure</a></li>
          <li><a href="/legal/crisis-protocol">Crisis Protocol</a></li>
          <li><a href="/legal/community-moderation">Community Moderation</a></li>
        </ul>
      </nav>
      <p class="footer-crisis"><a href="tel:988">Crisis: 988</a></p>
      <p class="footer-built">Built with ❤️ by CC3PO — AI-powered tools for real people</p>
    </div>
  </footer>

  <style is:global>
    /* Nightshift tokens (CC3PO Design System, Figma KHo1hzUoGXIOzyGMJgsEDH).
       Accent discipline per fleet standard: #cf2e4f carries white text (5.05:1);
       #ef6a87 is accent text/tint on dark (5.76:1). One value never does both. */
    :root {
      --bg: #0a0a12;
      --surface: #11111f;
      --surface-2: #171726;
      --border: rgba(255, 255, 255, 0.12);
      --text: #ffffff;
      --muted: rgba(255, 255, 255, 0.78);
      --accent: #e8506b;
      --accent-strong-bg: #cf2e4f;
      --accent-tint: #ef6a87;
      --focus: #ef6a87;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --radius-md: 16px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    .skip-link {
      position: absolute;
      top: -100%;
      left: 0;
      background: var(--accent-strong-bg);
      color: #fff;
      padding: 0.75rem 1rem;
      z-index: 200;
      font-size: 1rem;
    }
    .skip-link:focus { top: 0; }

    a { color: var(--accent-tint); }
    a:focus-visible, button:focus-visible, audio:focus-visible, video:focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }

    .container { max-width: 48rem; margin: 0 auto; padding: 0 1.25rem; }
    .container-wide { max-width: 64rem; margin: 0 auto; padding: 0 1.25rem; }
    .section { padding: 3.5rem 0 4rem; }

    h1, h2, h3 { font-weight: 400; letter-spacing: -0.02em; line-height: 1.25; }
    h1 { font-size: 2.25rem; }
    h2 { font-size: 1.625rem; margin-top: 2.5rem; }
    h3 { font-size: 1.25rem; margin-top: 2rem; }

    .prose p { font-size: 1.0625rem; font-weight: 300; color: var(--muted); margin: 0 0 1rem; }
    .prose p strong, .prose li strong { color: var(--text); }
    .prose h1, .prose h2, .prose h3 { color: var(--text); }
    .prose h1:first-child { margin-top: 0; }
    .prose ul { color: var(--muted); font-weight: 300; font-size: 1.0625rem; padding-left: 1.5rem; margin: 0 0 1rem; }
    .prose li { margin-bottom: 0.375rem; }

    /* Header */
    .site-header {
      border-bottom: 1px solid var(--border);
      background: var(--bg);
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .header-inner {
      max-width: 72rem;
      margin: 0 auto;
      padding: 0.5rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .brand {
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
      font-size: 1rem;
      padding: 0.625rem 0;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
    .nav-list {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
      margin: 0;
      padding: 0;
    }
    .nav-list a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0.5rem 0.625rem;
      border-radius: 8px;
      color: var(--muted);
      text-decoration: none;
      font-size: 0.9375rem;
    }
    .nav-list a:hover { color: var(--text); background: var(--surface); }

    /* Persistent crisis strip — every page, first paint, no hunting. */
    .crisis-strip {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      text-align: center;
      padding: 0.5rem 1rem;
    }
    .crisis-strip p { margin: 0; font-size: 0.9375rem; color: var(--muted); }
    .crisis-strip a { font-weight: 600; padding: 0.5rem 0.25rem; display: inline-block; min-height: 44px; line-height: 1.9; }

    /* Footer */
    .site-footer {
      border-top: 1px solid var(--border);
      margin-top: 4rem;
      padding: 2.5rem 0 3rem;
      text-align: center;
    }
    .footer-mission { font-style: italic; color: var(--muted); margin: 0 0 1.5rem; }
    .footer-links {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.25rem 1.25rem;
      margin: 0 0 1.25rem;
      padding: 0;
    }
    .footer-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.9375rem;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
    .footer-links a:hover { color: var(--text); }
    .footer-crisis { margin: 0 0 0.75rem; }
    .footer-crisis a { font-weight: 600; display: inline-flex; align-items: center; min-height: 44px; padding: 0.5rem 0.75rem; }
    .footer-built { color: var(--muted); font-size: 0.8125rem; margin: 0; }

    input, textarea, select { font-size: 16px; }

    @media (max-width: 480px) {
      h1 { font-size: 1.875rem; }
      .section { padding: 2.5rem 0 3rem; }
      .header-inner { justify-content: center; text-align: center; }
      .nav-list { justify-content: center; }
    }
  </style>
</body>
</html>
